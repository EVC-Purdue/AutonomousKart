#!/usr/bin/env bash
# Build and run the kart: kart [<mode>|stop|restart [<mode>]], where <mode>
# is any name with a matching launch/bringup_<mode>.launch.py (sim, pi,
# jetson, rubik, ...). Defaults to pi.
set -o pipefail  # not -u: ROS setup.bash reads AMENT_TRACE_SETUP_FILES unguarded

WS="${KART_WS:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PIDFILE="$WS/.kart.pgid"
LOG="$WS/logs/kart.log"

say()  { printf '\033[1m[kart]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[kart]\033[0m %s\n' "$*" >&2; }

OWN_PGID="$(ps -o pgid= -p $$ | tr -d ' ')"

_pgid_of() { ps -o pgid= -p "$1" 2>/dev/null | tr -d ' '; }

# $PIDFILE holds "<role> <pgid>" per line. The role picks the stop signal.
stack_groups() {
  local role pg pid out=""
  # Skipping OWN_PGID is what stops a stray match killing kart itself.
  _keep() {
    [ -n "$2" ] && [ "$2" != "$OWN_PGID" ] && kill -0 "-$2" 2>/dev/null \
      && ! printf '%s' "$out" | grep -q " $2\$" && out+="$1 $2"$'\n'
    return 0
  }
  if [ -f "$PIDFILE" ]; then
    while read -r role pg; do _keep "$role" "$pg"; done < "$PIDFILE"
  fi
  # No pidfile: recover launch from the :8000 holder, recorder from its path.
  pid="$(ss -ltnpH "sport = :8000" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)"
  [ -n "$pid" ] && _keep launch "$(_pgid_of "$pid")"
  while read -r pid; do
    _keep recorder "$(_pgid_of "$pid")"
  done < <(pgrep -f "bash $WS/scripts/start.bash" 2>/dev/null)
  printf '%s' "$out" | grep . || return 1
}

stack_pgids() { stack_groups | awk '{print $2}'; }
running_pgid() { stack_pgids | head -1; }

_gone() {  # every listed process group is dead
  local pg
  for pg in $1; do kill -0 "-$pg" 2>/dev/null && return 1; done
  return 0
}

_wait_gone() {  # $1 = groups, $2 = 50 ms ticks to wait
  for _ in $(seq "$2"); do _gone "$1" && return 0; sleep 0.05; done
  _gone "$1"
}

_signal_and_wait() {  # $1 = signal, $2 = groups, $3 = 50 ms ticks to wait
  local pg
  for pg in $2; do kill -"$1" "-$pg" 2>/dev/null; done
  for _ in $(seq "$3"); do _gone "$2" && return 0; sleep 0.05; done
  _gone "$2"
}

reap() {
  local groups pgs role pg
  groups="$(stack_groups)" || { rm -f "$PIDFILE"; return 0; }
  pgs="$(echo "$groups" | awk '{print $2}')"
  say "stopping stack (pgid $(echo $pgs))"
  # INT for the python launch group, TERM for the recorder which ignores INT.
  while read -r role pg; do
    case "$role" in
      recorder) kill -TERM "-$pg" 2>/dev/null ;;
      *)        kill -INT  "-$pg" 2>/dev/null ;;
    esac
  done <<< "$groups"
  _wait_gone "$pgs" 140 \
    || _signal_and_wait TERM "$pgs" 20 \
    || _signal_and_wait KILL "$pgs" 10
  rm -f "$PIDFILE"
}

preflight() {
  local dev out=""
  for dev in /dev/ttyACM0:CAN /dev/ttyTHS1:GPS /dev/i2c-7:IMU /dev/video0:CAM; do
    if [ -e "${dev%%:*}" ]; then out+="${dev##*:} ok  "
    else out+="${dev##*:} MISSING  "; fi
  done
  say "hardware  $out"
  say "solver    $(python - <<'PY' 2>/dev/null || echo 'numpy (probe failed)'
try:
    from autonomous_kart.nodes.pathfinder.planners.mpc_cuda import describe_solver
    print(describe_solver())
except Exception:
    print("numpy")
PY
)"
}

# str2str degrades silently on a dropped upstream NTRIP connection -- GPS
# keeps working, just without RTK correction, with nothing surfacing that
# it happened. This logs the up/down transitions and exits on its own once
# str2str (checked via the :9195 relay port) is gone, so it never orphans.
ntrip_watchdog() {
  local caster=108.59.49.226 cport=9000 up prev=""
  while ss -ltnH "sport = :9195" 2>/dev/null | grep -q .; do
    if ss -tnH "dst ${caster}:${cport}" 2>/dev/null | grep -q ESTAB; then up=1; else up=0; fi
    if [ "$up" != "$prev" ]; then
      if [ "$up" = 1 ]; then say "ntrip     correction link up"
      else warn "ntrip     correction link DOWN -- GPS degrading to non-RTK"
      fi
      prev=$up
    fi
    sleep 15
  done
}

# NTRIP relay + link watchdog, in kart's own group, never reaped, so they
# outlive a restart.
start_ntrip() {
  if ss -ltnH "sport = :9195" 2>/dev/null | grep -q .; then
    say "ntrip     already up on :9195"
    return
  fi
  str2str -in ntrip://shayman1:shayman1@108.59.49.226:9000/MSM4_VRS \
          -out tcpsvr://:9195 -b 1 -p 40.4376975222 -86.9444409756 200 \
          >> "$WS/logs/str2str.log" 2>&1 &
  say "ntrip     relaying to :9195"
  ntrip_watchdog >> "$WS/logs/str2str.log" 2>&1 &
}

# stop needs only ps/kill/ss, and sourcing the env costs 0.6 s.
if [ "${1:-}" = stop ]; then
  reap
  ss -ltnH "sport = :9195" 2>/dev/null | grep -q . \
    && say "ntrip     left running on :9195"
  exit 0
fi

source "$WS/scripts/kart_env.sh"

FORCE=0
MODE="${1:-pi}"
if [ "$MODE" = restart ]; then
  FORCE=1
  MODE="${2:-pi}"
fi
if [ ! -f "$WS/src/autonomous_kart/autonomous_kart/launch/bringup_${MODE}.launch.py" ]; then
  warn "no launch file for mode '$MODE'"; exit 2
fi

if pg="$(running_pgid)"; then
  if [ "$FORCE" = 1 ]; then
    reap
  else
    warn "already running (pgid $pg); another terminal may own it. kart stop | kart restart"
    exit 1
  fi
fi

T0=$(date +%s.%N)
el() { printf '%5.2f s' "$(echo "$(date +%s.%N) - $T0" | bc)"; }

# A daemon started before the stack caches an empty graph and outlives it.
ros2 daemon stop >/dev/null 2>&1

mkdir -p "$WS/logs"
preflight

if ! ( cd "$WS" && colcon build --packages-select autonomous_kart ) > "$WS/logs/build.log" 2>&1; then
  warn "build failed, see $WS/logs/build.log"
  tail -20 "$WS/logs/build.log" >&2
  exit 1
fi
source "$WS/install/setup.bash"
say "built     $(el)"

[ -e /dev/ttyTHS1 ] && start_ntrip

: > "$LOG"
: > "$PIDFILE"
export PYTHONUNBUFFERED=1 RCUTILS_LOGGING_BUFFERED_STREAM=0 RCUTILS_COLORIZED_OUTPUT=1
setsid bash -c "echo launch \$\$ >> '$PIDFILE'; exec ros2 launch autonomous_kart bringup_${MODE}.launch.py" \
  > >(stdbuf -oL -eL tee -a "$LOG") 2>&1 &
LP=$!
trap 'reap; exit 0' INT TERM

# Recorder gate: own group so reap gets it and its rosbag2 child.
setsid bash -c "echo recorder \$\$ >> '$PIDFILE'; exec bash '$WS/scripts/start.bash'" &

for _ in $(seq 300); do
  curl -s --max-time 1 http://127.0.0.1:8000/ >/dev/null 2>&1 && break
  if ! kill -0 "$LP" 2>/dev/null; then
    warn "launch exited before master_api came up, see $LOG"
    reap; exit 1
  fi
  sleep 0.1
done
say "up        $(el)  pgid $(awk '{printf "%s ", $2}' "$PIDFILE")"
# Reap on a normal exit too, or a dying launch leaves the recorder polling.
wait "$LP"
reap
